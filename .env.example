# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_NAME=booklibre
POSTGRES_USER=
POSTGRES_PASSWORD=

# MongoDB (local: variables separadas / nube: usar MONGODB_URI directamente)
MONGO_HOST=mongos
MONGO_PORT=27017
MONGO_DB=booklibre
MONGO_USER=
MONGO_PASSWORD=
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority

# Redis (URL completa — Render Key Value provee esto)
# Local: host/port → el application.yml arma redis://redis:6379 (servicio "redis").
REDIS_HOST=redis
REDIS_PORT=6379
# [RENDER] Render Key Value provee una URL completa. Si REDIS_URL está seteada, tiene
# prioridad sobre REDIS_HOST/REDIS_PORT. Dejar comentada en local.
# REDIS_URL=redis://<host>:<port>

# JWT
# IMPORTANTE: el secreto debe tener AL MENOS 32 caracteres (256 bits) o el back no arranca
# Este es un secreto de desarrollo; en Render usar uno propio y fuerte. Si se borra esta linea, tambien funciona en local.
JWT_SECRET=local-dev-secret-booklibre-cambiar-en-produccion-2026